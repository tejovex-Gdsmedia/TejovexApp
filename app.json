{
  "expo": {
    "name": "Task Manager",
    "slug": "TaskManager",
    "scheme": "taskmanager",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.YOURNAME.taskmanager"
    },
    "android": {
      "package": "com.YOURNAME.taskmanager",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "@react-native-community/datetimepicker",
      "expo-image",
      "expo-font",
      "expo-sharing",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Tejovex uses your location, only while the app is open, to confirm you are punching in or out from the office. Location is never tracked in the background."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Tejovex uses your camera to take a selfie that verifies your attendance punch."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Tejovex uses Face ID to verify your identity when you punch in or out."
        }
      ]
    ]
  }
}
