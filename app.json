{
  "expo": {
    "name": "Task Manager",
    "slug": "TaskManager",
    "scheme": "taskmanager",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.YOURNAME.taskmanager"
    },
    "android": {
      "package": "com.tejovex.taskmanager",
      "googleServicesFile": "./google-services.json",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#1A73E8",
          "defaultChannel": "default"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-image",
      "expo-font",
      "expo-sharing",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Tejovex uses your location, only while the app is open, to confirm you are punching in or out from the office. Location is never tracked in the background."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Tejovex uses Face ID to verify your identity when you punch in or out."
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "c267b037-557f-43dd-930f-1463684a137c"
      }
    },
    "owner": "techgds"
  }
}
